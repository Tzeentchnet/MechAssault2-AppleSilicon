include_guard(GLOBAL)

function(ma2_assert_source target source)
    get_target_property(_sources ${target} SOURCES)
    if(NOT source IN_LIST _sources)
        message(FATAL_ERROR "${target} is missing required source ${source}")
    endif()
endfunction()

function(ma2_assert_link target library)
    get_target_property(_links ${target} LINK_LIBRARIES)
    get_target_property(_interface ${target} INTERFACE_LINK_LIBRARIES)
    if(NOT library IN_LIST _links AND NOT library IN_LIST _interface)
        message(FATAL_ERROR "${target} is missing required library ${library}")
    endif()
endfunction()

function(ma2_assert_chunks)
    foreach(_source IN LISTS MA2_LEGACY_XMM_SOURCES)
        get_source_file_property(_definitions "${_source}" COMPILE_DEFINITIONS)
        if(NOT "RECOMP_XMM_INTRIN=0" IN_LIST _definitions)
            message(FATAL_ERROR "A generated chunk lost its required XMM definition")
        endif()
    endforeach()
    foreach(_source IN LISTS MA2_NOINLINE_SOURCES)
        get_source_file_property(_options "${_source}" COMPILE_OPTIONS)
        if(WIN32)
            set(_required /Ob0)
        else()
            set(_required -fno-inline-functions)
        endif()
        if(NOT _required IN_LIST _options)
            message(FATAL_ERROR "A generated chunk lost its no-inline option")
        endif()
    endforeach()
endfunction()

function(ma2_assert_windows_graph)
    get_property(_languages GLOBAL PROPERTY ENABLED_LANGUAGES)
    if(NOT RC IN_LIST _languages)
        message(FATAL_ERROR "The Windows graph must enable the RC language")
    endif()
    foreach(_target IN ITEMS mechassault2_recomp mechassault2_launcher)
        get_target_property(_gui ${_target} WIN32_EXECUTABLE)
        if(NOT _gui)
            message(FATAL_ERROR "${_target} must remain a Win32 GUI executable")
        endif()
    endforeach()
    foreach(_source IN ITEMS src/main.c src/recomp_manual.c src/app.rc
        src/pc_native_settings.cpp src/pc_storage.c src/bink_native.c
        src/scenario/ma2_scenario.c src/scenario/ma2_scenario_audio.cpp
        vendor/imgui-1.92.5/backends/imgui_impl_win32.cpp
        vendor/imgui-1.92.5/backends/imgui_impl_dx11.cpp)
        ma2_assert_source(mechassault2_recomp "${_source}")
    endforeach()
    ma2_assert_source(mechassault2_launcher src/launcher.c)
    ma2_assert_source(mechassault2_launcher src/app.rc)
    foreach(_source IN LISTS RECOMP_GEN_SOURCES)
        ma2_assert_source(mechassault2_recomp "${_source}")
    endforeach()
    foreach(_library IN ITEMS xboxrecomp d3d11 dxgi dxguid xinput winmm dbghelp)
        ma2_assert_link(mechassault2_recomp "${_library}")
    endforeach()
    foreach(_name IN ITEMS avcodec avformat avutil swscale)
        ma2_assert_link(mechassault2_recomp "${FFMPEG_DIR}/lib/${_name}.lib")
    endforeach()
    get_source_file_property(_imgui_definitions
        vendor/imgui-1.92.5/backends/imgui_impl_win32.cpp COMPILE_DEFINITIONS)
    if(NOT "IMGUI_IMPL_WIN32_DISABLE_GAMEPAD" IN_LIST _imgui_definitions)
        message(FATAL_ERROR "The Win32 ImGui gamepad gate is missing")
    endif()
    ma2_assert_chunks()
    if(MSVC)
        foreach(_target IN ITEMS mechassault2_recomp mechassault2_launcher)
            get_target_property(_options ${_target} LINK_OPTIONS)
            if(NOT "/MANIFEST:EMBED" IN_LIST _options OR
               NOT "/MANIFESTINPUT:${CMAKE_CURRENT_SOURCE_DIR}/src/app.manifest" IN_LIST _options)
                message(FATAL_ERROR "${_target} lost its embedded manifest")
            endif()
        endforeach()
        get_target_property(_link_options mechassault2_recomp LINK_OPTIONS)
        get_target_property(_compile_options mechassault2_recomp COMPILE_OPTIONS)
        if(NOT "/LARGEADDRESSAWARE" IN_LIST _link_options OR
           NOT "/MAP" IN_LIST _link_options OR NOT "/bigobj" IN_LIST _compile_options)
            message(FATAL_ERROR "The game lost required MSVC options")
        endif()
    endif()
endfunction()

function(ma2_assert_apple_graph)
    get_property(_languages GLOBAL PROPERTY ENABLED_LANGUAGES)
    if(NOT OBJC IN_LIST _languages OR NOT OBJCXX IN_LIST _languages OR RC IN_LIST _languages)
        message(FATAL_ERROR "The macOS graph needs Objective-C/C++ and must not enable RC")
    endif()
    if(TARGET xbox_d3d8 OR XBOXRECOMP_BUILD_D3D8)
        message(FATAL_ERROR "The macOS game graph must omit the bundled D3D8 target")
    endif()
    set(_apple_targets ma2_game_core xbox_kernel xbox_dsound xbox_input
        xbox_usb xbox_apu xbox_nv2a xbox_video platform apu_samplerate xboxrecomp
        ma2_apple_host ma2_apple_metal ma2_host_shell mechassault2_recomp)
    if(TARGET mechassault2_recomp_guest)
        list(APPEND _apple_targets mechassault2_recomp_guest)
    endif()
    foreach(_target IN LISTS _apple_targets)
        foreach(_property IN ITEMS LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
            get_target_property(_links ${_target} ${_property})
            if(_links)
                string(TOLOWER "${_links}" _links)
                if(_links MATCHES "(^|[;:/\\\\])(d3d11|dxgi|dxguid|d3dcompiler|xinput|winmm|dbghelp|kernel32|bcrypt|mfplat|mfreadwrite|mfuuid|mf|ole32|xaudio2_8|avrt)([;>]|$)" OR
                   _links MATCHES "\\.(lib|dll)([;>]|$)")
                    message(FATAL_ERROR "${_target} links a Windows-only dependency")
                endif()
            endif()
        endforeach()
        get_target_property(_sources ${_target} SOURCES)
        foreach(_source IN LISTS _sources)
            if(_target STREQUAL "ma2_game_core" AND MA2_GENERATED_DIR)
                get_filename_component(_source_dir "${_source}" DIRECTORY)
                if(_source_dir STREQUAL "${MA2_GENERATED_DIR}")
                    continue()
                endif()
            endif()
            if(_source MATCHES "\\.[Rr][Cc]$" OR
               _source MATCHES "(^|/)(main\\.c|launcher\\.c|pc_native_settings\\.cpp|pc_storage\\.c|pc_prompts\\.cpp|pc_gui_bridge\\.c|bink_native\\.c|ma2_scenario_audio\\.cpp|nv2a_pgraph_d3d11\\.c|nv2a_pb_replay\\.c|DDSTextureLoader11\\.cpp|imgui_impl_(win32|dx11)\\.cpp)$")
                message(FATAL_ERROR "${_target} contains a Windows-only source: ${_source}")
            endif()
        endforeach()
    endforeach()
    foreach(_source IN ITEMS src/pc_draw_distance.c src/audio_lifetime.c
        src/apple/ma2_bot_brain_compile.c src/bots/ma2_bot_content.c
        src/bots/ma2_bot_path.c src/bots/ma2_bot_terrain.c)
        ma2_assert_source(ma2_game_core "${_source}")
    endforeach()
    foreach(_source IN ITEMS nv2a_backend.c nv2a_texture_pack_stub.c)
        ma2_assert_source(xbox_kernel "${_source}")
    endforeach()
    ma2_assert_source(xbox_apu apu_sdl2.c)
    ma2_assert_source(xbox_video fb_present_sdl.c)
    ma2_assert_source(xbox_nv2a "${CMAKE_CURRENT_SOURCE_DIR}/src/apple/legacy_pgraph_unavailable.c")
    ma2_assert_link(xbox_kernel OpenSSL::Crypto)
    ma2_assert_link(xbox_input SDL2::SDL2)
    ma2_assert_link(xbox_apu SDL2::SDL2)
    ma2_assert_link(ma2_apple_host SDL2::SDL2)
    ma2_assert_link(ma2_apple_host "${MA2_APPKIT_FRAMEWORK}")
    ma2_assert_link(ma2_apple_host "${MA2_FOUNDATION_FRAMEWORK}")
    ma2_assert_link(ma2_apple_host "${MA2_QUARTZCORE_FRAMEWORK}")
    ma2_assert_source(ma2_apple_metal src/apple/metal/nv2a_metal.mm)
    ma2_assert_source(ma2_apple_metal src/apple/metal/nv2a_metal_memory.c)
    ma2_assert_link(ma2_apple_metal "${MA2_METAL_FRAMEWORK}")
    ma2_assert_link(ma2_apple_metal "${MA2_FOUNDATION_FRAMEWORK}")
    get_target_property(_host_type mechassault2_recomp TYPE)
    if(NOT _host_type STREQUAL "EXECUTABLE")
        message(FATAL_ERROR "The macOS host must be a real executable")
    endif()
    ma2_assert_source(mechassault2_recomp src/apple/host/host_main.c)
    ma2_assert_link(mechassault2_recomp ma2_host_shell)
    ma2_assert_link(ma2_host_shell ma2_apple_host)
    ma2_assert_link(ma2_host_shell xboxrecomp)
    get_target_property(_host_links ma2_host_shell LINK_LIBRARIES)
    get_target_property(_executable_links mechassault2_recomp LINK_LIBRARIES)
    if(ma2_game_core IN_LIST _host_links OR ma2_game_core IN_LIST _executable_links)
        message(FATAL_ERROR "The host shell must not pretend to link the generated guest")
    endif()
    if(MA2_GENERATED_DIR)
        if(NOT TARGET mechassault2_recomp_guest)
            message(FATAL_ERROR "Generated macOS inputs require a guest executable")
        endif()
        get_target_property(_guest_type mechassault2_recomp_guest TYPE)
        if(NOT _guest_type STREQUAL "EXECUTABLE")
            message(FATAL_ERROR "The generated macOS guest must be an executable")
        endif()
        ma2_assert_source(mechassault2_recomp_guest src/apple/host/host_main.c)
        ma2_assert_source(mechassault2_recomp_guest src/apple/guest/guest_bootstrap.c)
        ma2_assert_source(mechassault2_recomp_guest src/apple/guest/guest_signals.c)
        ma2_assert_link(mechassault2_recomp_guest ma2_host_shell)
        ma2_assert_link(mechassault2_recomp_guest ma2_game_core)
        ma2_assert_link(mechassault2_recomp_guest ma2_apple_metal)
        foreach(_source IN ITEMS src/recomp_manual.c src/ma2_tank_fixedstep.c
            src/bots/ma2_bots_ui.c src/apple/guest/optional_contracts.c)
            ma2_assert_source(ma2_game_core "${_source}")
        endforeach()
        foreach(_source IN LISTS RECOMP_GEN_SOURCES)
            ma2_assert_source(ma2_game_core "${_source}")
        endforeach()
        get_target_property(_definitions ma2_game_core COMPILE_DEFINITIONS)
        if(NOT "RECOMP_XMM_INTRIN=0" IN_LIST _definitions)
            message(FATAL_ERROR "The arm64 generated code must use scalar XMM helpers")
        endif()
        get_target_property(_options ma2_game_core COMPILE_OPTIONS)
        if(NOT "-ivfsoverlay" IN_LIST _options OR NOT "${MA2_ABI_OVERLAY}" IN_LIST _options)
            message(FATAL_ERROR "The arm64 generated code is missing its verified ABI overlay")
        endif()
        ma2_assert_chunks()
    endif()
endfunction()
